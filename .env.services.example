# Copiar a .env.services y generar un valor aleatorio distinto por variable.
# openssl rand -hex 32 para TOKEN, OTP, RECOVERY_SECRET e INTERNAL.
# openssl rand -base64 32 para OUTBOX, TOTP y PUSH_TOKEN.
LAB_AUTH_TOKEN_SECRET=
LAB_EMAIL_OTP_SECRET=
LAB_EMAIL_OUTBOX_KEY=
LAB_TOTP_ENCRYPTION_KEY=
LAB_RECOVERY_SECRET=
LAB_RECOVERY_OUTBOX_KEY=
LAB_PUSH_TOKEN_KEY=
LAB_AUTH_INTERNAL_SECRET=
LAB_BILLING_INTERNAL_SECRET=
LAB_OPERATIONS_INTERNAL_SECRET=
LAB_NOTIFICATIONS_AUTH_SECRET=
LAB_REALTIME_INTERNAL_SECRET=
LAB_NOTIFICATIONS_INTERNAL_SECRET=
