{
  "name": "hidro-mejora",
  "version": "1.0.0",
  "private": true,
  "description": "Hidro-Mejora — cliente Capacitor y panel administrativo independiente con API compartida",
  "scripts": {
    "build:web": "node scripts/build-web.js web",
    "build:admin": "node scripts/build-web.js admin",
    "test:config": "node --test Backend/test/config.test.js Backend/test/receipt-date.test.js scripts/test/public-api-config.test.js",
    "test:email": "node --test Backend/test/email-*.test.js",
    "test:email:schema": "node Backend/test/email-schema.cjs",
    "test:email:outbox": "node --test Backend/test/email-outbox-postgres.cjs Backend/test/email-outbox-api.cjs",
    "worker:email": "node Backend/workers/email-outbox.cjs",
    "test:email:contract": "node --test Backend/test/email-contract.cjs",
    "test:android:upgrade": "node --test scripts/test/android-upgrade.test.cjs",
    "test:android:transition": "node --test scripts/test/android-transition.cjs scripts/test/client-session.test.cjs",
    "test:android:session": "node --test scripts/test/secure-session.test.cjs Backend/test/android-session.cjs",
    "test:android:native": "node scripts/test/android-session-native.cjs",
    "test:email:api": "node Backend/test/email-api.cjs",
    "test:email:cleanup": "node Backend/test/email-cleanup.cjs",
    "test:email:cleanup:cli": "node Backend/test/email-cleanup-cli.cjs",
    "maintenance:email": "node Backend/maintenance/email-cleanup.cjs",
    "test:email:live": "node Backend/test/email-live.cjs --live",
    "test:email:e2e": "node scripts/test/admin-e2e.cjs",
    "test:chatbot": "node --test scripts/test/hidrobot.test.cjs",
    "test:documents": "node --test scripts/test/documents.test.cjs",
    "test:ui": "node --test scripts/test/ui-money.test.cjs",
    "test:receipts": "node --test Backend/test/receipt-concurrency.cjs Backend/test/receipt-schema.cjs",
    "cap:www": "bash scripts/sync-capacitor-www.sh",
    "cap:sync": "node scripts/sync-android.cjs",
    "cap:open": "npx cap open android",
    "android:gradle": "bash scripts/android-gradle.sh",
    "android:release": "node scripts/build-android-release.cjs",
    "test:android:otp": "node --test scripts/test/registration-state.test.cjs scripts/test/android-transition.cjs",
    "test:android:otp:native": "node scripts/test/android-session-native.cjs --otp",
    "test:android:location:native": "node scripts/test/android-session-native.cjs --location",
    "test:k8s": "node --test scripts/test/k8s-integration.test.cjs"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3"
  }
}
