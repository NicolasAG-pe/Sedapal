<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/hm_brand_blue</item>
        <item name="colorPrimaryDark">@color/hm_brand_navy</item>
        <item name="colorAccent">@color/hm_brand_teal</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/hm_brand_navy</item>
        <item name="android:navigationBarColor">@color/hm_brand_navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/hm_splash</item>
        <item name="windowSplashScreenBackground">@color/hm_brand_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/hm_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
