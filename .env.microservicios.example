# ============================================================
# Hidro-Mejora · PLANTILLA del laboratorio de microservicios
# Copiar y generar los valores LOCALES del laboratorio:
#   cp .env.microservicios.example .env.microservicios
#   sed -i "s|^LAB_AUTH_TOKEN_SECRET=.*|LAB_AUTH_TOKEN_SECRET=$(openssl rand -hex 32)|" .env.microservicios
#   sed -i "s|^LAB_EMAIL_OTP_SECRET=.*|LAB_EMAIL_OTP_SECRET=$(openssl rand -hex 32)|" .env.microservicios
#   sed -i "s|^LAB_EMAIL_OUTBOX_KEY=.*|LAB_EMAIL_OUTBOX_KEY=$(openssl rand -base64 32)|" .env.microservicios
#   sed -i "s|^LAB_TOTP_ENCRYPTION_KEY=.*|LAB_TOTP_ENCRYPTION_KEY=$(openssl rand -base64 32)|" .env.microservicios
#   sed -i "s|^LAB_NOTIFICATIONS_INTERNAL_SECRET=.*|LAB_NOTIFICATIONS_INTERNAL_SECRET=$(openssl rand -hex 32)|" .env.microservicios
#   sed -i "s|^LAB_AUTH_INTERNAL_SECRET=.*|LAB_AUTH_INTERNAL_SECRET=$(openssl rand -hex 32)|" .env.microservicios
# chmod 600 .env.microservicios
# El archivo .env.microservicios está en .gitignore: nunca se versiona.
# Cada clave debe ser distinta de las demás y de las del monolito (.env):
# los servicios rechazan claves compartidas en el arranque.
# ============================================================

# Secreto JWT del servicio Auth (hex, 32 bytes).
LAB_AUTH_TOKEN_SECRET=

# Secreto de OTP de registro de correo (hex, 32 bytes), exclusivo del JWT.
LAB_EMAIL_OTP_SECRET=

# Clave de cifrado de la outbox (base64 exacto de 32 bytes).
LAB_EMAIL_OUTBOX_KEY=

# Clave de cifrado de secretos TOTP (base64 exacto de 32 bytes).
LAB_TOTP_ENCRYPTION_KEY=

# Secreto HMAC interno de la pareja worker(Auth) <-> Notifications (hex, 32 bytes).
LAB_NOTIFICATIONS_INTERNAL_SECRET=

# Secreto HMAC interno del contrato de introspección de Auth (hex, 32 bytes).
LAB_AUTH_INTERNAL_SECRET=
