# ============================================================
# Hidro Mejora · PLANTILLA de variables para PRODUCCIÓN (VPS)
# Copiar como .env en el VPS y completar valores REALES y ÚNICOS.
#   cp .env.production.example .env
# NUNCA versionar el .env real (está en .gitignore).
# NO copiar valores del .env de desarrollo.
# ============================================================

# Render: configurar estas variables en su panel, sin copiar el .env local.
# DATABASE_URL debe ser la cadena PostgreSQL real de Neon.
# SSL externo valida certificado y host (verify-full).
# Render normalmente inyecta PORT; 3000 es el valor por defecto del backend.
DATABASE_URL=
PORT=3000
# POSTGRES_* / DB_* / WEB_PORT se conservan para la alternativa VPS anterior.

POSTGRES_DB=hidro_mejora
POSTGRES_USER=hidro_admin
POSTGRES_PASSWORD=cambia_esta_clave_por_una_larga_y_aleatoria

DB_HOST=db
DB_PORT=5432

# Secreto JWT: generar uno nuevo y exclusivo de producción, por ejemplo:
#   openssl rand -hex 64
AUTH_TOKEN_SECRET=cambia_este_secreto_por_uno_nuevo_de_produccion

NODE_ENV=production

# Puerto público del servicio web (detrás va el proxy HTTPS).
WEB_PORT=80

# Origen web público. Detrás del mismo dominio basta same-origin:
# dejar VACÍO o repetir el dominio. Para futuro Android, agregar el
# origen que corresponda (nunca '*').
# Ejemplo: CORS_ALLOWED_ORIGINS=https://DOMINIO_EJEMPLO
CORS_ALLOWED_ORIGINS=https://tu-proyecto.vercel.app,https://localhost
