POSTGRES_DB=hidro_mejora
POSTGRES_USER=hidro_admin
POSTGRES_PASSWORD=cambia_esta_clave
DB_HOST=db
DB_PORT=5432
# Docker mantiene la API en 3000 y utiliza POSTGRES_*.
# Para iniciar el backend fuera de Docker se puede usar DATABASE_URL.
PORT=3000
DATABASE_URL=
AUTH_TOKEN_SECRET=cambia_este_secreto
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,https://localhost,http://localhost
ADMIN_PORT=8081
NODE_ENV=development

# Solo servidores. El registro exige RESEND_FROM, EMAIL_OTP_SECRET y EMAIL_OUTBOX_KEY.
# Mantener cerrado; usar 1 solo en un entorno de correo autorizado/verificado.
EMAIL_REGISTRATION_ENABLED=0
# RESEND_API_KEY se configura únicamente en el trabajador independiente.
RESEND_API_KEY=
RESEND_FROM=
# Generar un secreto aleatorio independiente del JWT (al menos 32 bytes).
EMAIL_OTP_SECRET=
# Cifrado outbox: 32 bytes aleatorios base64, exclusivos (openssl rand -base64 32).
# La API no necesita RESEND_API_KEY; solo el trabajador independiente la utiliza.
EMAIL_OUTBOX_KEY=

# Solo backend. Clave AES-256 base64 independiente, respaldada fuera de Git.
# Requiere migración manual 007. Sin esta clave no se permite configurar 2FA.
TOTP_ENCRYPTION_KEY=
# Activar solo después de distribuir clientes compatibles; no afecta factores existentes.
TOTP_ENROLLMENT_ENABLED=0
# Resend se conserva como proveedor predeterminado. No activar servicios automáticamente.
EMAIL_PROVIDER=resend
EMAIL_WORKER_ENABLED=0
EMAIL_WORKER_SHARED_CONTAINER=0
# Canario opcional, validado en API y transporte; no incluir direcciones privadas aquí.
EMAIL_REGISTRATION_ALLOWED_EMAIL=
# Solo con EMAIL_PROVIDER=gmail; cuenta autorizada, sin alias ni dominio comprado.
GMAIL_SENDER=
# Solo worker: JSON privado 0600 generado por scripts/gmail-oauth.cjs, fuera del cliente/APK.
GMAIL_CREDENTIALS_FILE=
# Alternativa secreta del servidor ante montajes incompatibles; nunca poner tokens aquí.
GMAIL_CREDENTIALS_JSON=
