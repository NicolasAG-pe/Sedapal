        <mxCell id="106" value="Este recorrido se ejecuta en el frontend; no exige escritura en PostgreSQL ni un servicio externo de IA." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;strokeColor=#222222;fillColor=#ffffff;strokeWidth=2;text;align=left;fontSize=18;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="730" y="5320" width="1220" height="70" />
        </mxCell>
        <mxCell id="107" value="Mejoras del informe: experiencia común web/Android; datos relacionados con el usuario y suministro; persistencia, seguimiento y permisos;&#10;actualizaciones mediante eventos; orientación integrada. Cliente y administrador son actores humanos; frontend y servidor son componentes internos.&#10;La confirmación de un reporte no implica reparación física. El pago solo se registra en el prototipo: no se procesa dinero ni se supone una pasarela bancaria." style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=18;strokeColor=#222222;fillColor=#ffffff;strokeWidth=2;rounded=1;align=left;spacing=18;fillColor=#f5f5f5;fontSize=18;" vertex="1" parent="1">
